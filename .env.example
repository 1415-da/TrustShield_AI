# TrustShield AI — environment configuration
# Copy to .env and adjust. Never commit real secrets.

# --- LLM provider -------------------------------------------------------------
# mock   : deterministic offline provider (no API key needed) — default
# openai : any OpenAI-compatible Chat Completions endpoint
# azure  : Azure OpenAI (uses OPENAI_BASE_URL as the resource endpoint)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01
LLM_TIMEOUT_SECONDS=30

# --- Embeddings ---------------------------------------------------------------
# local : hashed TF vectors, zero downloads (default)
# sentence-transformers : requires `pip install sentence-transformers`
# openai : uses OPENAI_* settings with EMBEDDING_MODEL
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# --- Database -----------------------------------------------------------------
DATABASE_URL=postgresql://trustshield:trustshield@db:5432/trustshield
POSTGRES_USER=trustshield
POSTGRES_PASSWORD=trustshield
POSTGRES_DB=trustshield

# --- Auth ---------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Session cookies are HTTP-only. Set COOKIE_SECURE=true when serving TrustShield over HTTPS.
COOKIE_SECURE=false
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
ALLOW_SELF_REGISTRATION=true

# Password used for all seeded synthetic demo accounts.
DEMO_USER_PASSWORD=TrustShield-demo-2024

# --- Guardrails ---------------------------------------------------------------
# Set to false to force the regex-only PII engine (Presidio is used when installed).
PRESIDIO_ENABLED=true
SPACY_MODEL=en_core_web_sm
RETRIEVAL_TOP_K=5

# --- Slack (optional) ----------------------------------------------------------
# Leave SLACK_ENABLED=false to use only the built-in connected workspace (/workspace).
# Real Slack: create an app, enable Events API with request URL  https://<host>/api/integrations/slack/events
# and Interactivity URL https://<host>/api/integrations/slack/interactions. Bot scopes:
# app_mentions:read, channels:history, chat:write, users:read, users:read.email
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_TOKEN=
SLACK_VERIFICATION_TOKEN=
SLACK_WORKSPACE_NAME=
WORKSPACE_RATE_LIMIT_PER_MINUTE=20
# Base URL used for "View in TrustShield" links posted to Slack
PUBLIC_APP_URL=http://localhost:3000

# --- Compliance report scheduler ----------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=60

# --- Frontend -----------------------------------------------------------------
# Where the Next.js server proxies /api/* (server-side only; the browser never sees it).
BACKEND_URL=http://backend:8000
CORS_ORIGINS=http://localhost:3000

# --- Host ports (change if something else already uses them) --------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=55432
